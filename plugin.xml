<?xml version="1.0" encoding="UTF-8"?>
<!-- The plugin.dtd file is located in the OXYGEN_INSTALL_DIR/plugins directory. -->
<!DOCTYPE plugin SYSTEM "../plugin.dtd">

<plugin
  id="org.exist_db.oxygen.existdb"
  name="eXist-db"
  description="Connect to eXist-db 7 over HTTP (existdb-openapi): browse collections, open/save resources, run XQuery."
  version="${project.version}"
  vendor="eXist-db"
  class="com.existdb.oxygen.ExistdbPlugin"
  classLoaderType="preferReferencedResources">

  <runtime>
    <librariesFolder name="lib" />
  </runtime>

  <!-- Side view + menu/toolbar contributions: collection tree, connection, query. -->
  <extension type="WorkspaceAccess"
    class="com.existdb.oxygen.ExistdbWorkspaceAccessPluginExtension"/>

  <!-- exist: URL scheme so Oxygen can open and natively save DB resources round-trip. -->
  <extension type="URLStreamHandler"
    class="com.existdb.oxygen.ExistdbURLStreamHandlerPluginExtension"/>

  <!-- "eXist-db (HTTP)" XQuery engine: eXist-accurate validation (and, later, execution) via
       existdb-openapi. Appears in Oxygen's XQuery validation/transformation engine list. -->
  <extension type="XQueryTransformer"
    class="com.existdb.oxygen.ExistdbXQueryTransformerPluginExtension"/>

  <!-- The eXist-db side view (collection tree + connection controls). -->
  <view id="ExistdbBrowserViewID" initialSide="WEST" initialRow="0"/>

  <!-- The eXist-db results view (eXide-style paginated query results). -->
  <view id="ExistdbResultsViewID" initialSide="SOUTH" initialRow="0"/>
</plugin>
