<!-- Assembles the installable plugin JAR: plugin classes + bundled libs + plugin.xml. -->
<assembly
  xmlns="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.2"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.2 http://maven.apache.org/xsd/assembly-1.1.2.xsd">
  <id>plugin</id>
  <formats>
    <format>jar</format>
  </formats>
  <includeBaseDirectory>false</includeBaseDirectory>
  <fileSets>
    <fileSet>
      <directory>target/lib</directory>
      <outputDirectory>lib</outputDirectory>
      <includes>
        <include>**/*</include>
      </includes>
    </fileSet>
  </fileSets>
  <files>
    <file>
      <source>target/build/${project.build.finalName}.jar</source>
      <outputDirectory>lib</outputDirectory>
    </file>
    <file>
      <source>plugin.xml</source>
      <outputDirectory>/</outputDirectory>
      <filtered>true</filtered>
    </file>
    <!-- The license shown in Preferences → Plugins (referenced by plugin.xml's <license>). -->
    <file>
      <source>LICENSE</source>
      <outputDirectory>/</outputDirectory>
    </file>
    <!-- Add-on descriptor so the Preferences → Plugins detail pane shows license/author even for a
         manually-installed plugin (Oxygen reads <xt:license> from the extension descriptor). -->
    <file>
      <source>extension.xml</source>
      <outputDirectory>/</outputDirectory>
      <filtered>true</filtered>
    </file>
  </files>
</assembly>
